<form class="pure-g search" action="@{ url_for('do.search') }" method="post">
  <div class="icon" data-icon="search"> </div>
  <input aria-label="Search" name="term" placeholder="{{_('Title search...')}}" type="search" class="pure-u-1">
</form>

{%if current_user.logged_in %}
{% if config.site_front_page_submit %}
<a href="@{url_for('subs.submit', ptype='link', sub='')}" class="sbm-post pure-button">{{_('Submit a post')}}</a>
<hr>
{% endif %}
<a href="@{url_for('home.view_subs')}" class="sbm-post pure-button">{{_('View all subs')}}</a>
<a href="@{url_for('subs.random_sub')}" class="sbm-post pure-button">{{_('Go to random sub')}}</a>
@if config.site.sub_creation_admin_only == False or current_user.is_admin:
<a href="@{url_for('subs.create_sub')}" class="sbm-post pure-button">{{_('Create a sub')}}</a>
@end
{% endif %}

{% if home_data.top_posts %}
  <hr/>
  <div class="sidebarlists">
    <h4 class="center">{{_('Top posts in the last 24 hours')}}</h4>
    <ul class="top5">
      {% for post in home_data.top_posts %}
        <li>
          {% if config.site_top_posts_show_score %}
            <span class="sidescore">{{post['score']}} </span>
          {% endif %}
          <a class="title @{post['blur']}" href="/s/{{post.sub}}/{{post.pid}}">{{post.title}}</a>
          {% if post['nsfw'] or post['sub_nsfw'] %}
            <span class="nsfw" alt="Not safe for work">{{_('NSFW')}}</span>
          {% endif %}
          <div class="sidelocale">
            {{_p("{{timeago}} in {{sub}}", timeago='<time-ago datetime="' + post['posted'] + '"></time-ago>', sub='<a href="/s/' + post['sub'] + '">/s/' + post['sub'] + '</a>')}}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% if config.site_recent_activity_enabled %}
  <hr/>
  <div class="sidebarlists">
    <h4 class="center"><a href="/activity">{{_('Recent activity')}}</a></h4>
    <ul class="top5" id="activity_list_sidebar">
      {% for post in home_data.recent_activity %}
        <li>
          {% if post['type'] == 'comment' %}
            {{_p('{{user}} commented: {{text}}', user='<a href="/u/' + post['user'] + '">' + post['user'] + '</a>', text='<a class="title" href="/s/' + post['sub'] + '/' + post['pid'] + '">' + e(func.word_truncate(''.join(BeautifulSoup(markdown(post['content']), features='lxml').findAll(string=True)).replace('\n', ' '), 150)) + '</a>')}}
          {% else %}
            {{_p('{{user}} posted: {{text}}', user='<a href="/u/' + post['user'] + '">' + post['user'] + '</a>', text='<a class="title" href="/s/' + post['sub'] + '/' + post['pid'] + '">' + e(func.word_truncate(post['content'], 150)) + '</a>')}}
          {% endif %}
          @if post['nsfw'] or post['sub_nsfw']:
            <span class="nsfw smaller" alt="Not safe for work">{{_('NSFW')}}</span>
          @endif
          <div class="sidelocale">
            @{_("%(timeago)s in %(sub)s", timeago='<time-ago datetime="' + post['time'].isoformat() + 'Z"></time-ago>', sub='<a href="' + url_for('sub.view_sub', sub=post['sub']) + '">/' + config.site.sub_prefix + '/' + post['sub'] + '</a>') !!html}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
{% endif %}

{% if home_data.sub_of_the_day %}
  <hr>
  <div class="sidebarlists">
    <h4 class="center">{{_('Sub of the day')}}</h4>
    <ul>
      <li><a href="@{url_for('sub.view_sub', sub=subOfTheDay.name)}">/s/{{home_data.sub_of_the_day.name}}</a>
        <div class="sidelocale">{{home_data.sub_of_the_day.title}}</div></li>
    </ul>
  </div>
{% endif %}

{% if current_user.logged_in and (config.site_sitelog_public or current_user.can_admin) %}
<hr>
<a href="@{url_for('site.view_sitelog')}" class="sbm-post pure-button">{{_('Site logs')}}</a>
{% endif %}
